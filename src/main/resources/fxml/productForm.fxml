<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ul.fc.css.tascaeats.javafx.controllers.ProductFormController"
      spacing="15"
      style="-fx-padding: 20;">

    <stylesheets>
        <URL value="@../css/styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Title -->
    <Label text="Criar/Editar Produto" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <!-- Form -->
    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <!-- Nome -->
        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtName" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

        <!-- Descricao -->
        <Label text="Descrição:" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
        <TextArea fx:id="txtDescription" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="80" prefWidth="300"/>

        <!-- Preco -->
        <Label text="Preço:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrice" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300" promptText="0.00"/>

        <!-- Categoria -->
        <Label text="Categoria:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboCategory" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

        <!-- Disponivel -->
        <Label text="Disponivel:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <CheckBox fx:id="checkAvailable" GridPane.rowIndex="4" GridPane.columnIndex="1" selected="true"/>
    </GridPane>

    <!-- Buttons -->
    <HBox spacing="10" style="-fx-alignment: center;">
        <Button text="Guardar" onAction="#save" style="-fx-font-size: 12; -fx-padding: 10 40;"/>
        <Button text="Cancelar" onAction="#cancel" style="-fx-font-size: 12; -fx-padding: 10 40;"/>
    </HBox>

    <!-- Status -->
    <Label fx:id="lblStatus" text="Pronto" style="-fx-font-size: 11; -fx-text-fill: #666666;"/>

</VBox>
