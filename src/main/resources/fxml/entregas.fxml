<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.net.URL?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ul.fc.css.tascaeats.javafx.controllers.EntregasController"
    spacing="16"
    styleClass="page-container">

    <stylesheets>
        <URL value="@../css/styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Title -->
    <Label text="Entregas" styleClass="section-title"/>
    <Label text="Segue a operação logística com atualização de estado e rastreamento imediato." styleClass="section-subtitle" wrapText="true"/>

    <!-- Button Bar -->
    <HBox spacing="10" styleClass="toolbar" style="-fx-alignment: center-left;">
        <Button text="Atribuir Manual" onAction="#assignDeliveryManual"/>
        <Button text="Atribuir Automático" onAction="#assignDeliveryAuto"/>
        <Button text="Iniciar Entrega" onAction="#startSelectedDelivery" styleClass="button-secondary"/>
        <Button text="Concluir Entrega" onAction="#concludeSelectedDelivery" styleClass="button-secondary"/>
        <Button fx:id="btnCancelarEntrega" text="Cancelar Entrega" onAction="#cancelSelectedDelivery" styleClass="button-secondary"/>
        <Button text="Rastrear" onAction="#trackDelivery"/>
        <Button text="Recarregar" onAction="#refresh"/>
    </HBox>

    <!-- Entregas Table -->
    <TableView fx:id="tblEntregas" prefHeight="400" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colEntregaId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colEntregaData" text="Data/Hora" prefWidth="150"/>
            <TableColumn fx:id="colEntregaEndereco" text="Endereço" prefWidth="250"/>
            <TableColumn fx:id="colEntregaStatus" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colEntregaTempo" text="Tempo Est." prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Status Bar -->
    <HBox spacing="10" styleClass="status-bar" style="-fx-alignment: center-left;">
        <Label fx:id="lblEntregaStatus" text="Pronto" styleClass="label,muted"/>
        <Label fx:id="lblTotalEntregas" text="Total: 0 entregas" styleClass="label,muted"/>
    </HBox>

</VBox>
