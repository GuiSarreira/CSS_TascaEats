<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.net.URL?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ul.fc.css.tascaeats.javafx.controllers.PagamentosController"
    spacing="16"
    styleClass="page-container">

    <stylesheets>
        <URL value="@../css/styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Title -->
    <Label text="Pagamentos" styleClass="section-title"/>
    <Label text="Consulta histórico, valor total e regista novos pagamentos." styleClass="section-subtitle" wrapText="true"/>

    <!-- Button Bar -->
    <HBox spacing="10" styleClass="toolbar" style="-fx-alignment: center-left;">
        <Button text="Processar Pagamento" onAction="#processPayment" styleClass="button-secondary"/>
        <Button text="Recarregar" onAction="#refresh"/>
    </HBox>

    <!-- Pagamentos Table -->
    <TableView fx:id="tblPagamentos" prefHeight="400" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPagamentoId" text="ID" prefWidth="70"/>
            <TableColumn fx:id="colPedidoId" text="Pedido ID" prefWidth="90"/>
            <TableColumn fx:id="colPagamentoData" text="Data/Hora" prefWidth="170"/>
            <TableColumn fx:id="colPagamentoValor" text="Valor (EUR)" prefWidth="110"/>
            <TableColumn fx:id="colPagamentoMetodo" text="Método" prefWidth="130"/>
            <TableColumn fx:id="colPagamentoStatus" text="Estado" prefWidth="130"/>
        </columns>
    </TableView>

    <!-- Status Bar -->
    <HBox spacing="10" styleClass="status-bar" style="-fx-alignment: center-left;">
        <Label fx:id="lblPagamentoStatus" text="Pronto" styleClass="label,muted"/>
        <Label fx:id="lblTotalPagamentos" text="Total: 0 pagamentos" styleClass="label,muted"/>
        <Label fx:id="lblValorTotal" text="Valor Total: EUR 0.00" styleClass="label,muted"/>
    </HBox>

</VBox>
