<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.ul.fc.css.tascaeats.javafx.controllers.UserRegistrationController"
      spacing="15"
    styleClass="page-container">

    <stylesheets>
        <URL value="@../css/styles.css"/>
    </stylesheets>

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Title -->
    <Label text="Registar Novo Utilizador" styleClass="section-title"/>
    <Label text="Cria administradores e entregadores." styleClass="section-subtitle" wrapText="true"/>

    <!-- Registration Form -->
    <GridPane hgap="10" vgap="10" styleClass="card">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <!-- Tipo de Utilizador -->
        <Label text="Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboUserType" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

        <!-- Nome -->
        <Label text="Nome:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtName" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

        <!-- Email -->
        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

        <!-- Password -->
        <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtPassword" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

        <!-- Telemovel -->
        <Label text="Telemóvel:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPhone" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300"/>

        <!-- Zona de Entrega -->
        <Label text="Zona de Entrega:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="txtZoneArea" GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="300" visible="false"/>
    </GridPane>

    <!-- Buttons -->
    <HBox spacing="10" style="-fx-alignment: center;">
        <Button text="Registar" onAction="#register" styleClass="button-secondary"/>
        <Button text="Limpar" onAction="#cancel"/>
    </HBox>

    <!-- Status -->
    <Label fx:id="lblStatus" text="Pronto" styleClass="label,muted"/>

</VBox>
